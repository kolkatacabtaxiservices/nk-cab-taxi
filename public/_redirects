# Netlify _redirects file
# Processed by Netlify CDN — 301/302 redirects for legacy URLs only.
# Docs: https://docs.netlify.com/routing/redirects/
#
# ══════════════════════════════════════════════════════════════════════════════
# ⚠️  IMPORTANT: APEX DOMAIN REDIRECT — SET IN NETLIFY DOMAIN SETTINGS
# ══════════════════════════════════════════════════════════════════════════════
# Netlify _redirects CANNOT handle hostname-level redirects (apex → www).
# The apex→www redirect (nkcabtaxi.com → www.nkcabtaxi.com) is set automatically
# when you configure the primary domain in:
#
#   Netlify Dashboard → Site configuration → Domain management
#     → Add domain alias: nkcabtaxi.com
#     → Set www.nkcabtaxi.com as primary domain
#
# Netlify automatically handles the 301 redirect for the apex domain.
# ══════════════════════════════════════════════════════════════════════════════

# ── Fix: Legacy singular path typos → canonical plural paths ──────────────────
/route/* /routes/:splat 301
/service/* /services/:splat 301

# ── Fix: Duplicate route pages → dedicated hand-built landing pages ───────────
/routes/kolkata-to-jamshedpur/* /kolkata-to-jamshedpur-cab/ 301
/routes/kolkata-to-jamshedpur /kolkata-to-jamshedpur-cab/ 301
/routes/jamshedpur-to-kolkata/* /jamshedpur-to-kolkata-cab/ 301
/routes/jamshedpur-to-kolkata /jamshedpur-to-kolkata-cab/ 301

# ── Fix: Legacy suffix variants → canonical route ─────────────────────────────
/routes/*-cab /routes/:splat/ 301
/routes/*-taxi /routes/:splat/ 301
/routes/*-service /routes/:splat/ 301
/routes/*-booking /routes/:splat/ 301

# ── Fix: Legacy Kolkata area URLs ─────────────────────────────────────────────
/west-bengal/salt-lake-kolkata /kolkata/salt-lake/ 301
/west-bengal/new-town-kolkata /kolkata/new-town/ 301

# ── Fix: Service rename: Two-Way → Round Trip ──────────────────────────────────
/services/two-way /services/round-trip/ 301
/:state/:city/two-way /:state/:city/round-trip/ 301

# ── Trailing slash: handled natively by Next.js trailingSlash:true ────────────
# With output:"export" + trailingSlash:true, Next.js generates every page as
# slug/index.html. Netlify serves slug/index.html at /slug/ returning 200.
# The old catch-all rules below are REMOVED — they were redundant with the
# static file structure and could create loops in edge cases.
#
# REMOVED (redundant):
#   /routes/:slug /routes/:slug/ 301
#   /:state/:city/:service /:state/:city/:service/ 301
#   /:state/:city /:state/:city/ 301
#
# If Netlify ever needs a fallback for non-slash → slash, uncomment ONE rule:
# /* /:splat/ 301  <-- nuclear option: only if Netlify stops serving index.html
