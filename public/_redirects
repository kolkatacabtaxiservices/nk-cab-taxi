# Cloudflare Pages _redirects file
# Processed by Cloudflare CDN — 301/302 redirects for legacy URLs only.
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/
#
# ══════════════════════════════════════════════════════════════════════════════
# ⚠️  IMPORTANT: APEX DOMAIN REDIRECT — MUST BE IN CLOUDFLARE DASHBOARD
# ══════════════════════════════════════════════════════════════════════════════
# Cloudflare Pages _redirects CANNOT handle hostname-level redirects.
# The apex→www redirect (nkcabtaxi.com → www.nkcabtaxi.com) MUST be set in:
#
#   Cloudflare Dashboard → Rules → Redirect Rules → Create Rule
#     IF:   Hostname equals "nkcabtaxi.com"
#     THEN: Redirect to https://www.nkcabtaxi.com${http.request.uri.path}
#           Type: Static  |  Status: 301  |  Preserve query string: YES
#
# Without that dashboard rule, nkcabtaxi.com returns 405 — killing PageRank.
# ══════════════════════════════════════════════════════════════════════════════

# ── Fix: Legacy singular path typos → canonical plural paths ──────────────────
/route/* /routes/:splat 301
/service/* /services/:splat 301

# ── Fix: Duplicate route pages → dedicated hand-built landing pages ───────────
# /routes/<slug> duplicates the hardcoded /kolkata-to-jamshedpur-cab and
# /jamshedpur-to-kolkata-cab pages (canonical). MUST stay ABOVE the suffix-
# stripping rules below — first match wins, and /routes/<slug>-cab must still
# resolve to the same final destination without a redirect loop.
/routes/kolkata-to-jamshedpur/* /kolkata-to-jamshedpur-cab 301
/routes/kolkata-to-jamshedpur /kolkata-to-jamshedpur-cab 301
/routes/jamshedpur-to-kolkata/* /jamshedpur-to-kolkata-cab 301
/routes/jamshedpur-to-kolkata /jamshedpur-to-kolkata-cab 301

# ── Fix: Legacy suffix variants → canonical route ─────────────────────────────
/routes/*-cab /routes/:splat 301
/routes/*-taxi /routes/:splat 301
/routes/*-service /routes/:splat 301
/routes/*-booking /routes/:splat 301

# ── Fix: Legacy Kolkata area URLs ─────────────────────────────────────────────
/west-bengal/salt-lake-kolkata /kolkata/salt-lake 301
/west-bengal/new-town-kolkata /kolkata/new-town 301

# ── Fix: Service rename: Two-Way → Round Trip ──────────────────────────────────
/services/two-way /services/round-trip 301
/:state/:city/two-way /:state/:city/round-trip 301

