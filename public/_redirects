# Cloudflare Pages _redirects file
# Processed by Cloudflare CDN — 301/302 redirects for legacy URLs only.
# Docs: https://developers.cloudflare.com/pages/configuration/redirects/

# ── Fix: Legacy singular path typos → canonical plural paths ──────────────────
/route/* /routes/:splat 301
/service/* /services/:splat 301

# ── Fix: Legacy suffix variants → canonical route ─────────────────────────────
/routes/*-cab /routes/:splat 301
/routes/*-taxi /routes/:splat 301
/routes/*-service /routes/:splat 301
/routes/*-booking /routes/:splat 301

# ── Fix: Legacy Kolkata area URLs ─────────────────────────────────────────────
/west-bengal/salt-lake-kolkata /kolkata/salt-lake 301
/west-bengal/new-town-kolkata /kolkata/new-town 301

# ── Fix: Service rename: Two-Way → Round Trip ──────────────────────────────────
/services/two-way /services/round-trip 301
/:state/:city/two-way /:state/:city/round-trip 301

