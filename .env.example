# NK Cab & Taxi — Environment Variables
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git

# ─────────────────────────────────────────────────────────
# REQUIRED — Site URL (used in metadata & canonical URLs)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.nkcabtaxi.com

# ─────────────────────────────────────────────────────────
# OPTIONAL — Google Apps Script (Booking Form submissions)
# Setup: scripts/google-apps-script.js → deploy as Web App
# ─────────────────────────────────────────────────────────
# GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ─────────────────────────────────────────────────────────
# CLOUDFLARE — Required for `npm run deploy` via CLI
# Get from: https://dash.cloudflare.com/profile/api-tokens
# ─────────────────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN=your_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
