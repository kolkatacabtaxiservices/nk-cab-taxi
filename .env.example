# NK Cab & Taxi — Environment Variables
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git

# ─────────────────────────────────────────────────────────
# REQUIRED — Site URL (used in metadata & canonical URLs)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.nkcabtaxi.com

# ─────────────────────────────────────────────────────────
# OPTIONAL — Google Apps Script (Booking Form submissions)
# Setup: scripts/google-apps-script.js → deploy as Web App
# ─────────────────────────────────────────────────────────
# GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ─────────────────────────────────────────────────────────
# REQUIRED for /api/indexnow — IndexNow API key
# This is the key from your /public/<key>.txt file.
# No fallback — the endpoint returns 500 if not set.
# ─────────────────────────────────────────────────────────
# INDEXNOW_API_KEY=your_indexnow_key_here

# ─────────────────────────────────────────────────────────
# REQUIRED for /api/indexnow — Admin secret to call the endpoint
# Set a strong random string; pass as x-api-key header when calling the endpoint.
# No fallback — the endpoint returns 401 if not set.
# ─────────────────────────────────────────────────────────
# INDEXNOW_ADMIN_KEY=your_strong_random_secret_here

# ─────────────────────────────────────────────────────────
# REQUIRED for /api/reindex — Admin secret to call the reindex endpoint
# Set a strong random string; pass as x-api-key header when calling the endpoint.
# No fallback — the endpoint returns 401 if not set.
# ─────────────────────────────────────────────────────────
# REINDEX_API_KEY=your_strong_random_secret_here

# ─────────────────────────────────────────────────────────
# CLOUDFLARE — Required for `npm run deploy` via CLI
# Get from: https://dash.cloudflare.com/profile/api-tokens
# ─────────────────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN=your_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
